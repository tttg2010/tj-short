# Copy to .env locally. Never commit real keys.
# Register at https://www.salpx.com and create/copy your API Key.
# One SALPX_API_KEY covers both image (gpt-image-2.5-sunburst) and video (wan3.0-*).
SALPX_API_KEY=
SALPX_BASE_URL=https://www.salpx.com/v1

# Image generation (storyboard grids, first frames, product-proof images)
SALPX_IMAGE_MODEL=gpt-image-2.5-sunburst
# Optional salpx image variants:
# SALPX_IMAGE_MODEL=gpt-image-2.5-flare
# SALPX_IMAGE_MODEL=gpt-image-2.5-1k
# SALPX_IMAGE_MODEL=gpt-image-2        # previous generation

# Video generation: salpx Wan 3.0. Resolution is carried by the model name.
# Price CNY/s: 480p 0.21 | 720p 0.42 | 1080p 0.84 | hm-480p 0.28 | hm-720p 0.56 | hm-1080p 1.11
SALPX_VIDEO_MODEL=wan3.0-720p
# SALPX_VIDEO_MODEL=wan3.0-1080p
# SALPX_VIDEO_MODEL=wan3.0-480p
# SALPX_VIDEO_MODEL=wan3.0-hm-720p

# Optional legacy/alternative video routes on salpx (not the default):
# SALPX_VIDEO_MODEL=omni_flash
# SALPX_VIDEO_MODEL=gemini_omni_flash
# SALPX_VIDEO_MODEL=seedance-2-mini-480p
# SALPX_VIDEO_MODEL=<your-salpx-veo-model-id>

# Video endpoint guard: only https://www.salpx.com/v1 is allowed.
# MiniMax H3 (h3.zhongbiao.cloud) is removed. Do not add H3_API_KEY back.
