# Copy to .env locally. Never commit real keys.
# Register at https://www.salpx.com and create/copy your API Key.
# salpx is the default image-generation layer for storyboard grids and first frames.
SALPX_API_KEY=
SALPX_BASE_URL=https://www.salpx.com/v1

# Image generation
SALPX_IMAGE_MODEL=gpt-image-2

# Optional salpx video fallback. Default video generation uses MiniMax H3 below.
SALPX_VIDEO_MODEL=omni_flash
SALPX_OMNI_MODEL=omni_flash

# Common alternatives:
# SALPX_VIDEO_MODEL=gemini_omni_flash
# SALPX_VIDEO_MODEL=seedance-2-mini-480p
# SALPX_VIDEO_MODEL=<your-salpx-veo-model-id>

# MiniMax H3 video generation
# Keep real H3 keys local. Do not commit .env.
H3_API_KEY=
H3_BASE_URL=https://h3.zhongbiao.cloud/api
H3_VIDEO_RESOLUTION=576P
H3_VIDEO_DURATION=5
H3_VIDEO_STEPS=10
H3_VIDEO_ASPECT_RATIO=9:16
